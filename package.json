{
  "name": "simulations-persona-agent",
  "version": "1.0.0",
  "description": "Lokaler Simulations-Persona-Agent mit Nuxt, Ollama und SQLite.",
  "type": "module",
  "scripts": {
    "dev": "NUXT_TELEMETRY_DISABLED=1 nuxt dev",
    "build": "NUXT_TELEMETRY_DISABLED=1 nuxt build",
    "preview": "NUXT_TELEMETRY_DISABLED=1 nuxt preview",
    "serve": "HOST=127.0.0.1 PORT=3000 node .output/server/index.mjs",
    "test": "vitest run",
    "typecheck": "nuxt typecheck",
    "check": "npm run test && npm run typecheck"
  },
  "keywords": [
    "nuxt",
    "ollama",
    "sqlite",
    "persona",
    "simulation",
    "leadership-training",
    "interventionstechniken"
  ],
  "author": "Andrea Koch",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "nuxt": "^4.4.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  }
}
